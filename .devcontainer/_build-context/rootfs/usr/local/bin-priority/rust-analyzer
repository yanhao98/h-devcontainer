#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

# rust-analyzer shim: automatically install Rust tooling, then execute rust-analyzer
# @verify: rust-analyzer --version

source /devcontainer/shim-utils.sh
_print_caller_info

cargo_bin_dir="${CARGO_HOME:-$HOME/.cargo}/bin"
export PATH="$cargo_bin_dir${PATH:+:$PATH}"
rust_analyzer_bin="$(_get-real-bin --silent rust-analyzer)"
rustup_bin="$(_get-real-bin --silent rustup)"

if [ -z "$rust_analyzer_bin" ] || [ ! -x "$rust_analyzer_bin" ] || [ -z "$rustup_bin" ] || [ ! -x "$rustup_bin" ]; then
    echo "rust-analyzer is not installed; installing via rustup..." >&2
    h-setup-rustup-bin >&2
    rust_analyzer_bin="$(_get-real-bin --silent rust-analyzer)"
    rustup_bin="$(_get-real-bin --silent rustup)"
    if [ -z "$rust_analyzer_bin" ] && [ -x "$cargo_bin_dir/rust-analyzer" ]; then
        rust_analyzer_bin="$cargo_bin_dir/rust-analyzer"
    fi
    if [ -z "$rustup_bin" ] && [ -x "$cargo_bin_dir/rustup" ]; then
        rustup_bin="$cargo_bin_dir/rustup"
    fi
fi

active_toolchain_line="$("$rustup_bin" show active-toolchain)"
active_toolchain="${active_toolchain_line%% *}"
component_list="$("$rustup_bin" component list --toolchain "$active_toolchain" --installed)"

if ! grep -q '^rust-analyzer-' <<<"$component_list"; then
    echo "rust-analyzer component is not installed for $active_toolchain; installing via rustup..." >&2
    "$rustup_bin" component add --toolchain "$active_toolchain" rust-analyzer >&2
fi

exec _exec-real-bin rust-analyzer "$@"
