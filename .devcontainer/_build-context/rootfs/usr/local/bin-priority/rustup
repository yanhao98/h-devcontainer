#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

# rustup shim: automatically install Rust tooling, then execute rustup
# @verify: rustup --version

source /devcontainer/shim-utils.sh
_print_caller_info

cargo_bin_dir="${CARGO_HOME:-$HOME/.cargo}/bin"
export PATH="$cargo_bin_dir${PATH:+:$PATH}"
rustup_bin="$(_get-real-bin --silent rustup)"

if [ -z "$rustup_bin" ]; then
    echo "Rust tooling is not installed; installing rustup..." >&2
    h-setup-rustup-bin >&2
fi

exec _exec-real-bin rustup "$@"
